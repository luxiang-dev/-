<wxs module="i18n" src="../../../utils/i18n.wxs" />
<media-privacy id="mediaPrivacy" language="{{language}}" />
<view class="page-shell mall-page locale-page locale-{{language}}"><page-feedback language="{{language}}" loading="{{pageBusy && !pageData}}" error="{{pageError}}" bindretry="onRetry" />
  <view class="page-header"><view class="eyebrow">ONE / REWARDS</view><view class="page-title">{{i18n.t('积分礼品管理', language)}}</view></view>
  <view wx:if="{{!hasPermission && !pageBusy}}" class="card card-desc">{{i18n.t('此操作需要管理员权限', language)}}</view>
  <block wx:if="{{hasPermission && pageData}}">
    <view class="mall-tabs"><view class="{{tab === 'gifts' ? 'active' : ''}}" data-tab="gifts" bindtap="onTab">{{i18n.t('礼品管理', language)}}</view><view class="{{tab === 'records' ? 'active' : ''}}" data-tab="records" bindtap="onTab">{{i18n.t('兑换记录', language)}}</view><view class="{{tab === 'rule' ? 'active' : ''}}" data-tab="rule" bindtap="onTab">{{i18n.t('积分规则', language)}}</view></view>
    <view wx:if="{{pendingSave}}" class="card"><view class="card-desc">{{i18n.t('请先核对上次保存的礼品', language)}}</view><button class="ghost-button" bindtap="onRetrySave" disabled="{{submitting || uploading || moreLoading}}">{{i18n.t('重试保存', language)}}</button></view>
    <view wx:if="{{tab === 'rule'}}" class="card"><view class="section-title">{{i18n.t('消费返积分比例', language)}}</view><view class="card-desc">{{i18n.t('绑定不赠积分，仅实收消费返积分给邀请人。每笔向下取整，新比例只影响后续消费。', language)}}</view><view class="rate-row"><input type="digit" value="{{rate}}" disabled="{{submitting || uploading || moreLoading}}" bindinput="onRate" /><text>%</text></view><view class="card-desc">{{i18n.t('0至100，最多两位小数', language)}}</view><button class="primary-button" bindtap="onSaveRule" loading="{{submitting}}" disabled="{{submitting || uploading || moreLoading}}">{{i18n.t('保存积分规则', language)}}</button></view>
    <block wx:if="{{tab === 'gifts'}}"><button class="primary-button" bindtap="onNew" disabled="{{submitting || uploading || pendingSave}}">{{i18n.t('新增礼品', language)}}</button>
      <view wx:if="{{editing}}" class="card gift-form"><view class="section-title">{{i18n.t('礼品资料', language)}}</view><view class="gift-image-editor"><view>{{i18n.t('礼品图片', language)}}</view><image wx:if="{{draft.imageUrl}}" class="gift-cover" src="{{draft.imageUrl}}" mode="aspectFit" data-url="{{draft.imageUrl}}" bindtap="onPreviewImage" /><view class="form-actions"><button class="ghost-button" bindtap="onUploadImage" loading="{{uploading}}" disabled="{{uploading || submitting || pendingSave}}">{{i18n.t(draft.imageUrl ? '更换图片' : '上传礼品图片', language)}}</button><button wx:if="{{draft.imageUrl}}" class="ghost-button" bindtap="onRemoveImage" disabled="{{uploading || submitting || pendingSave}}">{{i18n.t('移除图片', language)}}</button></view><view class="card-desc">{{i18n.t('图片需保存礼品后公开展示', language)}}</view><view wx:if="{{imageError}}" class="gift-image-error">{{i18n.t(imageError, language)}}</view></view><view>{{i18n.t('礼品名称', language)}}</view><input value="{{draft.name}}" maxlength="60" data-field="name" disabled="{{submitting || uploading || pendingSave}}" bindinput="onField" /><view>{{i18n.t('礼品介绍', language)}}</view><textarea value="{{draft.description}}" maxlength="300" data-field="description" disabled="{{submitting || uploading || pendingSave}}" bindinput="onField" auto-height /><view class="form-grid"><view>{{i18n.t('兑换积分', language)}}<input value="{{draft.cost}}" type="number" data-field="cost" disabled="{{submitting || uploading || pendingSave}}" bindinput="onField" /></view><view>{{i18n.t('剩余库存', language)}}<input value="{{draft.stock}}" type="number" data-field="stock" disabled="{{submitting || uploading || pendingSave}}" bindinput="onField" /></view></view><view class="record-meta"><text>{{i18n.t('上架', language)}}</text><switch checked="{{draft.status === 1}}" disabled="{{submitting || uploading || pendingSave}}" bindchange="onStatus" color="#c7452d" /></view><view class="form-actions"><button class="ghost-button" bindtap="onClose" disabled="{{submitting || uploading || moreLoading}}">{{i18n.t('关闭', language)}}</button><button class="primary-button" bindtap="onSave" disabled="{{submitting || uploading || pendingSave}}" loading="{{submitting}}">{{i18n.t('保存礼品', language)}}</button></view></view>
      <view wx:for="{{pageData.gifts}}" wx:key="id" class="card"><image wx:if="{{item.imageUrl}}" class="gift-cover" src="{{item.imageUrl}}" mode="aspectFit" data-url="{{item.imageUrl}}" bindtap="onPreviewImage" /><view class="gift-name">{{item.name}}</view><view class="card-desc">{{item.description}}</view><view class="record-meta"><text>{{item.cost}} {{i18n.t('积分', language)}} · {{i18n.f('剩余 {0} 件', [item.stock], language)}}</text><text>{{i18n.t(item.status === 1 ? '已上架' : '已下架', language)}}</text></view><button class="ghost-button" data-id="{{item.id}}" bindtap="onEdit" disabled="{{submitting || uploading || pendingSave}}">{{i18n.t('编辑礼品', language)}}</button></view>
    </block>
    <block wx:if="{{tab === 'records'}}"><view wx:if="{{!pageData.records.length}}" class="card card-desc">{{i18n.t('暂无兑换记录', language)}}</view><view wx:for="{{pageData.records}}" wx:key="id" class="card"><view class="gift-name">{{item.giftName}}</view><view class="card-desc">{{item.userName}} · {{item.phone}}</view><view class="record-meta"><text>{{item.cost}} {{i18n.t('积分', language)}} · {{item.date}}</text><text>{{i18n.t(item.status === 'pending' ? '待领取' : item.status === 'fulfilled' ? '已领取' : '已取消', language)}}</text></view><view wx:if="{{item.status === 'pending'}}" class="form-actions"><button class="ghost-button" data-id="{{item.id}}" bindtap="onCancel" disabled="{{submitting || uploading || moreLoading}}">{{i18n.t('取消兑换', language)}}</button><button class="primary-button" data-id="{{item.id}}" bindtap="onFulfill" disabled="{{submitting || uploading || moreLoading}}">{{i18n.t('确认发放', language)}}</button></view></view><button wx:if="{{pageData.hasMore}}" class="ghost-button" bindtap="onMoreRecords" loading="{{moreLoading}}" disabled="{{moreLoading || uploading || submitting}}">{{i18n.t('加载更多', language)}}</button></block>
  </block>
</view>
