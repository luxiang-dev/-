<wxs module="i18n" src="../../utils/i18n.wxs" />
<view class="page-shell locale-page locale-{{language}} booking-page">
  <page-feedback language="{{language}}" loading="{{pageBusy}}" error="{{pageError}}" bindretry="onRetry"></page-feedback>
  <view class="page-header art-header">
    <image class="art-header-photo" src="{{filters.type === 'private' ? '/images/backgrounds/training-private.jpg' : '/images/backgrounds/gym-header.jpg'}}" mode="aspectFill" aria-hidden="true"></image>
    <view class="art-header-shade"></view>
    <view class="art-header-content">
    <view class="headline-row booking-title-row">
      <view class="page-title">{{i18n.f('训练预约', [], language)}}</view>
      <view class="store-badge" bindtap="onOpenStorePicker">{{runtime.currentStore.name}} ⌄</view>
    </view>
    <view class="page-subtitle" wx:if="{{runtime.isAuthenticated}}">{{i18n.f('可用权益：团课 {0} 次 · 专属 {1} 次', [pageData.assets.groupUnlimited ? i18n.t('无限', language) : pageData.assets.groupCount || 0, pageData.assets.privateUnlimited ? i18n.t('无限', language) : pageData.assets.privateCount || 0], language)}}</view><view class="page-subtitle" wx:else>{{i18n.f('先找到适合你的时间，登录后即可预约。', [], language)}}</view>
    </view>
  </view>

  <view class="card booking-controls">
    <view class="booking-type-switch">
      <view class="booking-type-tab {{pageData.filters.type === 'group' ? 'active' : ''}}" data-type="group" bindtap="onTypeChange">{{i18n.f('团体训练', [], language)}}</view>
      <view class="booking-type-tab {{pageData.filters.type === 'private' ? 'active' : ''}}" data-type="private" bindtap="onTypeChange">{{i18n.f('专属训练', [], language)}}</view>
    </view>

    <view wx:if="{{filters.type === 'group'}}" class="date-grid">
      <view wx:for="{{pageData.dates}}" wx:key="key" class="date-card {{pageData.filters.dateKey === item.key ? 'active' : ''}}" data-date-key="{{item.key}}" bindtap="onDateChange" hover-class="tap-feedback">
        <view class="date-card-kicker">{{i18n.t(item.displayWeekday, language)}}</view>
        <view class="date-card-label">{{item.displayMonthDay}}</view>
      </view>
    </view>

  </view>

  <view wx:if="{{filters.type === 'group'}}" class="booking-schedule-section">
    <view class="booking-section-heading"><view class="section-title">{{i18n.f('可预约场次', [], language)}}</view><text class="booking-result-count">{{i18n.f('{0} 个场次', [pageData.resultCount], language)}}</text></view>
    <view wx:if="{{!pageBusy && !pageError && pageData.schedules.length === 0}}" class="empty-state">
      <view class="empty-state-title">{{i18n.f('这一天还没有安排训练', [], language)}}</view>
      <view class="empty-state-desc">{{i18n.f('试试其他日期，或切换门店。', [], language)}}</view>
    </view>
    <view wx:for="{{pageData.schedules}}" wx:key="id" class="booking-schedule-card {{item.isBooked ? 'is-booked' : item.isFull ? 'is-full' : ''}}">
      <view class="booking-card-cover">
        <image class="booking-cover-photo" src="{{item.type === 'private' ? '/images/backgrounds/training-private.jpg' : '/images/backgrounds/training-group.jpg'}}" mode="aspectFill" aria-hidden="true"></image>
        <view class="booking-cover-shade"></view>
        <view class="booking-card-header">
          <view class="booking-time-range">
            <text class="booking-time-main">{{item.timeStart}}</text>
            <text class="booking-time-divider">—</text>
            <text class="booking-time-end">{{item.timeEnd}}</text>
          </view>
          <view class="booking-card-status {{item.isBooked ? 'is-booked' : item.isFull ? 'is-disabled' : ''}}">
            <view class="booking-status-dot"></view>
            <text>{{i18n.t(item.isBooked ? '已预约' : item.isFull ? '已满员' : '可预约', language)}}</text>
          </view>
        </view>
      </view>
      <view class="booking-card-info">
        <view class="booking-card-title">{{item.title}}</view>
        <view class="booking-card-meta"><text class="booking-meta-label">{{i18n.f('教练', [], language)}}</text><text class="booking-meta-value">{{item.coachName}}</text></view>
        <view class="booking-card-meta"><text class="booking-meta-label">{{i18n.f('门店', [], language)}}</text><text class="booking-meta-value">{{item.venue}}</text></view>
      </view>
      <view class="booking-card-footer">
        <view class="booking-capacity"><view class="capacity-label">{{i18n.f('预约人数', [], language)}}</view><view class="capacity-value">{{i18n.t(item.progressText, language)}}</view></view>
        <view class="booking-action-area">
          <button
            size="mini"
            class="booking-action-btn {{item.isBooked ? 'is-booked' : item.isFull ? 'is-full' : ''}}"
            data-schedule-id="{{item.id}}"
            data-title="{{item.title}}"
            bindtap="onBook"
            loading="{{bookingId === item.id}}" disabled="{{item.isBooked || item.isFull || bookingId || pageBusy || pageError}}"
          >{{i18n.t(bookingId === item.id ? '正在预约' : item.isBooked ? '已预约' : item.isFull ? '当前满员' : runtime.isAuthenticated ? '预约训练' : '登录后预约', language)}}</button>
          <view class="booking-action-hint">{{i18n.t(item.isBooked ? '请按时到馆训练' : item.isFull ? '试试其他场次' : pageData.assets.groupUnlimitedExpiry >= filters.dateKey ? '使用期限内无限次权益' : '使用 1 次团课权益', language)}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{filters.type === 'private'}}" class="private-booking-section">
    <view wx:if="{{privatePending}}" class="card private-pending">
      <view class="section-heading">{{i18n.t(privateSubmitting ? '正在预约' : '预约结果待确认', language)}}</view>
      <view class="private-pending-details">
        <view>{{privatePending.coachName}} · {{privatePending.storeName}}</view>
        <view>{{privatePending.date}} · {{privatePending.start}} — {{privatePending.end}}</view>
      </view>
      <view wx:if="{{!privateSubmitting}}" class="card-desc">{{i18n.t('请先核对原预约结果，再发起其他预约。', language)}}</view>
      <button class="primary-button" disabled="{{privateSubmitting || pageBusy || pageError}}" loading="{{privateSubmitting}}" bindtap="onBookPrivate">{{i18n.t('核对原预约', language)}}</button>
    </view>

    <block wx:else>
      <view class="card private-coach-card">
        <view class="private-panel-heading">
          <view class="section-heading">{{i18n.t('选择预约教练', language)}}</view>
          <button wx:if="{{pageData.selectedCoach}}" class="private-coach-control" bindtap="onChangeCoach" disabled="{{privateSubmitting}}">{{i18n.t('更换教练', language)}}</button>
          <text wx:elif="{{pageData.coaches.length}}" class="private-section-count">{{i18n.f('{0} 位教练', [pageData.coaches.length], language)}}</text>
        </view>

        <view wx:if="{{pageData.selectedCoach}}" class="private-coach-row selected" data-coach-id="{{pageData.selectedCoach.id}}" bindtap="onOpenCoachProfile" hover-class="tap-feedback">
          <image wx:if="{{pageData.selectedCoach.avatarUrl}}" class="private-coach-avatar" src="{{pageData.selectedCoach.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="private-coach-avatar">{{pageData.selectedCoach.avatarText}}</view>
          <view class="private-coach-main">
            <view class="private-coach-name">{{pageData.selectedCoach.name}}</view>
            <view class="private-coach-meta">{{pageData.selectedCoach.titleIsDefault ? i18n.t('场馆人员', language) : pageData.selectedCoach.title}}</view>
            <view class="private-coach-link">{{i18n.t('查看教练介绍 ›', language)}}</view>
          </view>
        </view>
        <block wx:elif="{{pageData.coaches.length}}">
          <view wx:for="{{pageData.privateCoachPreview}}" wx:key="id" class="private-coach-row" data-coach-id="{{item.id}}" bindtap="onOpenCoachProfile" hover-class="tap-feedback">
            <image wx:if="{{item.avatarUrl}}" class="private-coach-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="private-coach-avatar">{{item.avatarText}}</view>
            <view class="private-coach-main">
              <view class="private-coach-name">{{item.name}}</view>
              <view class="private-coach-meta">{{item.titleIsDefault ? i18n.t('场馆人员', language) : item.title}}</view>
              <view class="private-coach-link">{{i18n.t('查看教练介绍 ›', language)}}</view>
            </view>
            <button class="private-coach-select" data-coach-id="{{item.id}}" catchtap="onCoachChange" disabled="{{privateSubmitting}}">{{i18n.t('选择', language)}}</button>
          </view>
          <button wx:if="{{pageData.coaches.length > 3}}" class="private-coach-all" bindtap="onOpenCoachPicker" disabled="{{privateSubmitting}}">{{i18n.f('查看全部 {0} 位教练', [pageData.coaches.length], language)}}</button>
        </block>
        <view wx:elif="{{!pageBusy && !pageError}}" class="card-desc private-coach-empty">{{i18n.t('暂无可预约教练，请联系场馆', language)}}</view>
      </view>

      <view wx:if="{{pageData.selectedCoach}}" class="card private-time-card">
        <view class="section-heading">{{i18n.t('选择训练时间', language)}}</view>
        <view class="date-grid">
          <view wx:for="{{pageData.dates}}" wx:key="key" class="date-card {{filters.dateKey === item.key ? 'active' : ''}}" data-date-key="{{item.key}}" bindtap="onDateChange" hover-class="tap-feedback">
            <view class="date-card-kicker">{{i18n.t(item.displayWeekday, language)}}</view>
            <view class="date-card-label">{{item.displayMonthDay}}</view>
          </view>
        </view>
        <view class="private-time-grid">
          <picker class="private-time-picker" mode="time" value="{{privateStart}}" disabled="{{privateSubmitting}}" data-field="privateStart" bindchange="onPrivateTime">
            <view class="private-time-label">{{i18n.t('开始时间', language)}}</view>
            <view class="private-time-value">{{privateStart}} <text>⌄</text></view>
          </picker>
          <picker class="private-time-picker" mode="time" value="{{privateEnd}}" disabled="{{privateSubmitting}}" data-field="privateEnd" bindchange="onPrivateTime">
            <view class="private-time-label">{{i18n.t('结束时间', language)}}</view>
            <view class="private-time-value">{{privateEnd}} <text>⌄</text></view>
          </picker>
        </view>
        <view wx:if="{{!pageBusy && !pageError}}" class="private-busy">
          <view class="private-time-label">{{i18n.t('教练当天已占用时段', language)}}</view>
          <view wx:if="{{pageData.privateBusyTimes.length}}" class="private-busy-list">
            <text wx:for="{{pageData.privateBusyTimes}}" wx:key="id">{{item.timeRange}}</text>
          </view>
          <view wx:else class="private-busy-empty">{{i18n.t('暂无已占用时段', language)}}</view>
        </view>
        <view class="card-desc private-note">{{i18n.t('请私下与教练确认训练安排。开课前 2 小时可取消。', language)}}</view>
        <button class="primary-button" loading="{{privateSubmitting}}" disabled="{{privateSubmitting || pageBusy || pageError}}" bindtap="onBookPrivate">{{i18n.t(runtime.isAuthenticated ? '预约专属训练' : '登录后预约', language)}}</button>
      </view>
    </block>
  </view>

  <view wx:if="{{coachPickerVisible}}" class="coach-drawer-mask" bindtap="onCloseCoachPicker"></view>
  <view wx:if="{{coachPickerVisible}}" class="coach-drawer">
    <view class="coach-drawer-header">
      <view>
        <view class="coach-drawer-title">{{i18n.t('选择预约教练', language)}}</view>
        <view class="coach-drawer-subtitle">{{i18n.f('支持按姓名 / 岗位 / 熟悉项目搜索', [], language)}}</view>
      </view>
      <view class="coach-drawer-close" bindtap="onCloseCoachPicker">×</view>
    </view>
    <input class="coach-search-input" placeholder="{{i18n.f('搜索姓名、岗位、项目', [], language)}}" placeholder-class="coach-search-placeholder" value="{{coachKeyword}}" bindinput="onCoachKeywordInput" />
    <scroll-view class="coach-drawer-scroll" scroll-y="true" lower-threshold="100" bindscrolltolower="onCoachListLower">
      <view wx:for="{{pageData.visibleCoachOptions}}" wx:key="id" class="coach-option-item {{pageData.filters.coachId === item.id ? 'active' : ''}}" data-coach-id="{{item.id}}" bindtap="onOpenCoachProfile">
        <image wx:if="{{item.avatarUrl}}" class="coach-option-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image><view wx:else class="coach-option-avatar">{{item.avatarText}}</view>
        <view class="coach-option-main">
          <view class="coach-option-row">
            <view class="coach-option-name">{{item.name}}</view>
          </view>
          <view class="coach-option-meta">{{item.titleIsDefault ? i18n.t('场馆人员', language) : item.title}}</view>
          <view class="coach-option-meta coach-summary">{{item.summaryText}}</view>
          <view class="private-coach-link">{{i18n.t('查看教练介绍 ›', language)}}</view>
        </view>
        <button class="private-coach-select" data-coach-id="{{item.id}}" catchtap="onCoachChange" disabled="{{privateSubmitting || privatePending}}">{{i18n.t(filters.coachId === item.id ? '已选择' : '选择', language)}}</button>
      </view>
      <view wx:if="{{pageData.hasMoreCoachOptions}}" class="coach-more-hint">{{i18n.t('继续下滑查看更多教练', language)}}</view>
      <view wx:if="{{pageData.filteredCoachOptions.length === 0}}" class="empty-text">{{i18n.f('没有匹配到场馆人员，请换个关键词再试。', [], language)}}</view>
    </scroll-view>
  </view>

  <app-tabbar current="/pages/booking/index"></app-tabbar>
</view>
