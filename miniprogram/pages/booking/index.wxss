.booking-page .art-header,
.booking-page .art-header-content {
  min-height: 154rpx;
}

.booking-page .art-header-content {
  padding: 24rpx 26rpx;
}

.booking-page .art-header .page-title {
  margin: 0;
  font-size: 38rpx;
}

.booking-page .art-header .page-subtitle {
  margin-top: 8rpx;
}

.booking-controls {
  padding: 18rpx;
}

.booking-type-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #eeeee7;
}

.booking-type-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 66rpx;
  padding: 8rpx 10rpx;
  line-height: 1.35;
  text-align: center;
  color: #73786e;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 22rpx;
}

.booking-type-tab.active {
  color: #ffffff;
  background: #c7452d;
  box-shadow: 0 14rpx 28rpx rgba(199, 69, 45, 0.2);
}

.date-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 6rpx;
  margin-top: 16rpx;
}

.booking-result-count {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #7c8076;
  font-weight: 600;
}

.date-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 88rpx;
  min-width: 0;
  padding: 8rpx 2rpx;
  text-align: center;
  overflow-wrap: anywhere;
  border: 1rpx solid #e1e3d9;
  border-radius: 16rpx;
  background: #ffffff;
}

.date-card.active {
  border-color: #c7452d;
  background: #f9eae4;
}

.date-card-kicker {
  font-size: 22rpx;
  color: #7c8076;
  font-weight: 600;
}

.date-card-label {
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
  color: #20251f;
  font-weight: 600;
  line-height: 1.2;
}

.booking-schedule-section { margin-top: 32rpx; }
.booking-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 0 4rpx 4rpx; }
.booking-section-heading .section-title { color: #20251f; font-size: 28rpx; }
.booking-schedule-card { margin-top: 20rpx; padding: 0 28rpx 28rpx; border: 1rpx solid #e4e5dc; border-radius: 24rpx; background: #ffffff; overflow: hidden; }
.booking-card-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10rpx 18rpx; }
.booking-time-range { display: flex; align-items: baseline; gap: 12rpx; white-space: nowrap; }
.booking-time-main { font-size: 46rpx; line-height: 1.15; letter-spacing: -1rpx; color: #20251f; font-weight: 700; }
.booking-time-divider { color: #b2b6aa; font-size: 24rpx; }
.booking-time-end { font-size: 30rpx; font-weight: 500; color: #73786e; }
.booking-card-status { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; color: #597251; background: #f0f4ed; padding: 8rpx 12rpx; border-radius: 10rpx; font-size: 21rpx; font-weight: 500; white-space: nowrap; }
.booking-status-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: currentColor; }
.booking-card-status.is-disabled { background: #f1f1eb; color: #8a8e83; }
.booking-card-status.is-booked { background: #fbede7; color: #b8442d; }
.booking-card-info { margin-top: 10rpx; }
.booking-card-title { margin-top: 8rpx; font-size: 36rpx; line-height: 1.4; color: #20251f; font-weight: 600; word-break: break-word; }
.booking-card-meta { display: flex; align-items: baseline; gap: 16rpx; margin-top: 12rpx; font-size: 23rpx; line-height: 1.5; }
.booking-meta-label { flex-shrink: 0; color: #92968b; }
.booking-meta-value { min-width: 0; color: #63695e; word-break: break-word; }
.booking-card-footer { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #eeefe8; }
.booking-capacity { flex: 1; min-width: 0; }
.capacity-label { font-size: 21rpx; color: #92968b; }
.capacity-value { margin-top: 8rpx; font-size: 27rpx; color: #535b4e; font-weight: 600; line-height: 1.4; }
.booking-action-area { flex: 0 1 250rpx; width: 250rpx; max-width: 55%; min-width: 0; text-align: center; }
/* 覆盖原生 button 的尺寸规则，按钮始终以操作区为边界。 */
.booking-action-area button.booking-action-btn { width: 100%; min-width: 0; max-width: 100%; margin: 0; box-sizing: border-box; min-height: 80rpx; display: flex; align-items: center; justify-content: center; padding: 14rpx 20rpx; border-radius: 14rpx; background: #c7452d; color: #ffffff; font-size: 26rpx; font-weight: 600; line-height: 1.3; }
.booking-action-area button.booking-action-btn[disabled] { background: #e8eae2; color: #8a8e83; }
.booking-action-area button.booking-action-btn.is-booked { background: #f5e9e2; color: #b8442d; }
.booking-action-hint { margin-top: 10rpx; color: #92968b; font-size: 20rpx; line-height: 1.4; }
.booking-schedule-card.is-full .booking-time-main { color: #73786e; }
.booking-card-cover{position:relative;min-height:210rpx;margin:0 -28rpx;padding:28rpx;background:#29362d;overflow:hidden;display:flex;align-items:flex-end}
.booking-cover-photo{position:absolute;left:0;top:-28rpx;width:100%;height:440rpx;pointer-events:none}
.booking-cover-shade{position:absolute;left:0;top:0;width:100%;height:100%;background:linear-gradient(90deg,rgba(20,29,22,.92),rgba(20,29,22,.48) 52%,rgba(20,29,22,.12));pointer-events:none}
.booking-card-cover .booking-card-header{position:relative;z-index:1;width:100%;align-items:flex-end;flex-wrap:wrap;row-gap:18rpx}
.booking-card-cover .booking-time-main,.booking-schedule-card.is-full .booking-card-cover .booking-time-main{color:#fff}
.booking-card-cover .booking-time-end{color:#e5e5d7}.booking-card-cover .booking-time-divider{color:#cdd1c3}
.booking-card-cover .booking-card-status{background:rgba(248,250,242,.94);max-width:100%;white-space:normal;line-height:1.4}
.booking-card-cover .booking-card-status.is-booked{background:#fbede7}.booking-card-cover .booking-card-status.is-disabled{background:#efefe8}
.booking-schedule-section .empty-state { margin-top: 20rpx; padding: 48rpx 28rpx; border: 1rpx dashed #dce0d3; border-radius: 24rpx; background: #faf9f5; }

.coach-drawer-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  background: rgba(32, 37, 31, 0.45);
  backdrop-filter: blur(10px);
}

.coach-drawer {
  display: flex;
  flex-direction: column;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 121;
  height: 74vh;
  padding: 28rpx 24rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -24rpx 80rpx rgba(32, 37, 31, 0.18);
}

.coach-drawer-header {
  flex-shrink: 0;
  gap: 16rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.coach-drawer-header > view:first-child { flex: 1; min-width: 0; }

.coach-drawer-title {
  font-size: 32rpx;
  color: #20251f;
  font-weight: 600;
}

.coach-drawer-subtitle {
  margin-top: 10rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #7c8076;
  font-weight: 700;
}

.coach-drawer-close {
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 50%;
  background: #eeeee7;
  font-size: 34rpx;
  color: #20251f;
  font-weight: 700;
}

.coach-search-input {
  flex-shrink: 0;
  width: 100%;
  height: 76rpx;
  margin-top: 22rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e1e3d9;
  border-radius: 24rpx;
  background: #f7f7f2;
  color: #20251f;
  font-size: 24rpx;
}

.coach-drawer-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  overflow-y: auto;
  margin-top: 18rpx;
}

.coach-option-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid #e9e9e1;
}

.coach-option-item.active {
  border-radius: 16rpx;
  background: #f9eae4;
}

.coach-option-avatar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 22rpx;
  background: #20251f;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.coach-option-main {
  flex: 1;
  min-width: 0;
}

.coach-option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.coach-option-name {
  overflow-wrap: anywhere;
  font-size: 28rpx;
  color: #20251f;
  font-weight: 600;
}

.coach-option-meta {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #7c8076;
}

.private-panel-heading {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx 16rpx;
  margin-bottom: 18rpx;
}

.private-section-count {
  color: #657061;
  font-size: 22rpx;
}

.private-coach-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #ebece4;
}

.private-coach-row.selected {
  padding: 20rpx;
  border: 1rpx solid #dce4d7;
  border-radius: 16rpx;
  background: #f0f3eb;
}

.private-coach-avatar {
  display: flex;
  flex: 0 0 80rpx;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #304037;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.private-coach-main {
  flex: 1;
  min-width: 0;
}

.private-coach-name {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.private-coach-meta,
.private-coach-link {
  margin-top: 6rpx;
  color: #596557;
  font-size: 22rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.private-coach-link {
  color: #903a29;
}

.locale-page button.private-coach-select,
.locale-page button.private-coach-control,
.locale-page button.private-coach-all {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-height: 68rpx;
  margin: 0;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #f5ede7;
  color: #903a29;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.4;
  white-space: normal;
  overflow-wrap: anywhere;
}

.locale-page button.private-coach-select {
  flex: 0 1 126rpx;
  max-width: 31%;
}

.locale-page button.private-coach-control {
  max-width: 100%;
  background: #edf1ea;
  color: #314637;
}

.locale-page button.private-coach-all {
  width: 100%;
  margin-top: 8rpx;
  background: #edf1ea;
  color: #314637;
}

.locale-page button.private-coach-select[disabled],
.locale-page button.private-coach-control[disabled],
.locale-page button.private-coach-all[disabled] {
  opacity: .55;
}

.private-coach-empty { padding-bottom: 8rpx; }

.coach-summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  overflow-wrap: anywhere;
}

.coach-more-hint {
  padding: 24rpx;
  text-align: center;
  color: #657061;
  font-size: 22rpx;
  line-height: 1.5;
}

.private-time-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.private-time-picker {
  display: block;
  min-width: 0;
  padding: 16rpx;
  border: 1rpx solid #e0e4d9;
  border-radius: 14rpx;
  background: #f5f6f1;
}

.private-time-label {
  color: #586356;
  font-size: 23rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.private-time-value {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 8rpx;
  color: #213229;
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.private-time-value text { color: #687565; }

.private-busy {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx 16rpx;
  margin-top: 18rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #e9ebe3;
}

.private-busy-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.private-busy-list text {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #f5ece6;
  color: #803d2f;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.private-busy-empty {
  color: #657061;
  font-size: 22rpx;
}

.private-pending {
  border-color: #e8cdb9;
  background: #fffbf5;
}

.private-pending-details {
  margin: 14rpx 0;
  color: #26322a;
  font-size: 26rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.private-note { margin-top: 18rpx; }

.locale-page .private-time-card button,
.locale-page .private-pending button {
  width: 100%;
  height: auto;
  margin: 18rpx 0 0;
}
