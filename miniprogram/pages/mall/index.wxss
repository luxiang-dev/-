.mall-page{padding-bottom:70rpx}.mall-hero{position:relative;overflow:hidden;border-radius:24rpx;margin-bottom:24rpx;color:#fff;min-height:280rpx}.mall-hero image,.hero-shade{position:absolute;width:100%;height:100%;inset:0}.hero-shade{background:linear-gradient(100deg,rgba(20,28,23,.95),rgba(20,28,23,.45))}.hero-content{position:relative;padding:32rpx}.hero-content .eyebrow{color:#d9c6ac}.hero-balance{font-size:72rpx;font-weight:800;margin:12rpx 0}.hero-balance text{font-size:24rpx}.mall-tabs{display:flex;background:#e9ece4;border-radius:16rpx;padding:6rpx;margin:24rpx 0;gap:4rpx}.mall-tabs>view{flex:1;text-align:center;min-width:0;padding:18rpx 8rpx;line-height:1.4;font-size:25rpx;font-weight:600;border-radius:12rpx}.mall-tabs .active{background:#fff;color:#bd412c}.gift-label{color:#bd412c;font-size:20rpx;letter-spacing:4rpx;margin-bottom:14rpx}.gift-name{font-size:32rpx;font-weight:700;overflow-wrap:anywhere}.gift-description{white-space:pre-wrap;margin:14rpx 0 26rpx}.gift-card{background:linear-gradient(125deg,#fff,#f4eee5)}.gift-bottom{display:flex;align-items:center;gap:20rpx;justify-content:space-between}.gift-price{font-size:38rpx;font-weight:800}.gift-price text{font-size:23rpx;font-weight:400}.mall-page button{box-sizing:border-box;min-width:0;white-space:normal;line-height:1.4;height:auto;min-height:76rpx;padding:18rpx 24rpx;display:flex;align-items:center;justify-content:center;margin:16rpx 0 0;width:100%;font-size:26rpx}.gift-bottom button{max-width:46%;margin:0}.record-meta{display:flex;flex-wrap:wrap;justify-content:space-between;gap:14rpx;margin-top:18rpx;font-size:24rpx;color:#778074}.record-status{color:#bd412c}.mall-note{text-align:center}.gift-form>view{margin-top:16rpx}.gift-form input,.gift-form textarea,.rate-row input{box-sizing:border-box;width:100%;background:#f5f5f0;border:1rpx solid #e1e5dc;border-radius:12rpx;padding:20rpx;min-height:82rpx;margin:12rpx 0 22rpx;font-size:28rpx}.gift-form textarea{min-height:140rpx}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.form-grid>view{min-width:0}.form-actions{display:flex;gap:14rpx}.form-actions button{flex:1}.rate-row{display:flex;align-items:center;gap:20rpx}.rate-row input{flex:1}.mall-page .card-desc{overflow-wrap:anywhere;white-space:pre-wrap}
.hero-content .page-title{color:#fff}

.gift-cover{display:block;box-sizing:border-box;width:100%;height:300rpx;margin:0 0 22rpx;border-radius:16rpx;background:#f2f3ed}.gift-image-editor .card-desc{margin-top:16rpx}.gift-image-error{margin-top:16rpx;padding:18rpx;color:#9c3625;background:#fff2ed;border-radius:12rpx;font-size:24rpx;line-height:1.6}

/* 客户商城采用双列陈列，管理员编辑页继续使用完整表单。 */
.rewards-page{padding:24rpx 24rpx 60rpx;background:#f5f3ee;min-height:100vh;box-sizing:border-box}
.rewards-page .mall-hero{min-height:0;margin-bottom:24rpx;border:1rpx solid #354239;border-radius:20rpx;background:#1f2c25}
.rewards-page .mall-hero>image{opacity:.35}
.rewards-page .hero-shade{background:linear-gradient(100deg,rgba(20,30,24,.98),rgba(20,30,24,.58))}
.rewards-page .hero-content{padding:28rpx;display:flex;align-items:center;justify-content:space-between;gap:24rpx}
.hero-heading{flex:1;min-width:0}
.rewards-page .eyebrow{font-size:18rpx;letter-spacing:3rpx;line-height:1.4;color:#d8c5a6}
.rewards-page .page-title{font-size:36rpx;line-height:1.3;margin:10rpx 0 12rpx;letter-spacing:1rpx}
.hero-caption{font-size:21rpx;line-height:1.5;color:#ced5ca}
.hero-account{max-width:42%;min-width:100rpx;text-align:right;flex-shrink:0;overflow-wrap:anywhere;color:#d8c5a6;font-size:21rpx;line-height:1.4}
.rewards-page .hero-balance{font-size:52rpx;font-weight:700;line-height:1.1;margin:0 0 8rpx;color:#f1e6d1;overflow-wrap:anywhere}
.rewards-page .mall-tabs{margin:0 0 24rpx;padding:0;gap:32rpx;background:transparent;border-bottom:1rpx solid #deddd4;border-radius:0}
.rewards-page .mall-tabs>view{padding:14rpx 4rpx 18rpx;font-size:25rpx;line-height:1.4;border-radius:0;color:#8b8c80;border-bottom:3rpx solid transparent}
.rewards-page .mall-tabs .active{color:#24362a;background:transparent;border-color:#a28350;font-weight:700}
.gift-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20rpx;align-items:stretch}
.rewards-page .gift-card{min-width:0;overflow:hidden;border-radius:16rpx;border:1rpx solid #e2dfd4;background:#fff;box-shadow:0 6rpx 18rpx rgba(40,46,34,.035);display:flex;flex-direction:column}
.gift-visual{height:180rpx;flex-shrink:0;background:#ecece5;border-bottom:1rpx solid #eeeae0}
.rewards-page .gift-cover{height:100%;width:100%;margin:0;border-radius:0;background:#f0f0ea;object-fit:contain}
.gift-placeholder{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(135deg,#e8e9de,#f6f3e9);color:#9c8967;gap:12rpx}
.gift-monogram{font-size:68rpx;font-weight:300;line-height:1;font-family:Georgia,serif;color:#858e77}
.gift-placeholder text{font-size:16rpx;letter-spacing:4rpx}
.gift-info{padding:16rpx;display:flex;flex-direction:column;flex:1;min-width:0}
.rewards-page .gift-name{font-size:27rpx;line-height:1.45;font-weight:600;color:#253227;min-height:72rpx;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere}
.rewards-page .gift-description{font-size:21rpx;line-height:1.5;color:#929388;margin:6rpx 0 14rpx;min-height:32rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rewards-page .gift-bottom{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:6rpx 10rpx;margin-top:auto}
.rewards-page .gift-price{font-size:34rpx;font-weight:700;line-height:1.3;color:#947548;overflow-wrap:anywhere;min-width:0}
.rewards-page .gift-price text{font-size:19rpx;color:#8c816a;font-weight:400}
.gift-stock{font-size:19rpx;line-height:1.4;color:#929388;overflow-wrap:anywhere}
.rewards-page .gift-info button{width:100%;min-height:60rpx;margin:16rpx 0 0;padding:12rpx 8rpx;border-radius:9rpx;font-size:23rpx;line-height:1.4;background:#293e30;color:#f7f2e6;font-weight:500;border:1rpx solid #293e30}
.rewards-page .gift-info button[disabled]{background:#efeee8;color:#777c70;border-color:#e9e7df;opacity:1}
.rewards-page .record-status{color:#947548}
